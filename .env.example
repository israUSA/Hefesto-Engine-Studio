# Opcional, solo para desarrollo. Las claves se cargan en la app (Ajustes → Proveedores,
# o `npx nx run api:cli keys set NOMBRE`) y se guardan cifradas con Windows DPAPI.
# Si una clave está en la bóveda y acá, gana la bóveda. .env nunca se sube al repo.

# Carpeta de trabajo (base de datos, videos, recursos). Por defecto: ~/HefestoHome
HEFESTO_HOME=

# Binarios (ffmpeg, whisper-cli, modelos). Por defecto: ./bin
HEFESTO_BIN_DIR=

# Codificador de video: auto | h264_nvenc | h264_qsv | h264_amf | libx264
HEFESTO_ENCODER=auto

# Modelo de Whisper en bin/models
HEFESTO_WHISPER_MODEL=ggml-large-v3-turbo-q5_0.bin

# Proveedores
GEMINI_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
OPENAI_COMPAT_API_KEY=

# Fase 3: Google Drive (OAuth de escritorio)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
